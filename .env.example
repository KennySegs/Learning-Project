# Copy this file to .env and fill in values from:
# Supabase → Project Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Clerk — Dashboard → API keys → Publishable key (safe for the browser; starts with pk_)
# https://dashboard.clerk.com/~/api-keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# For Supabase RLS: Clerk Dashboard → JWT Templates → New template based on Supabase (name: "supabase").
# Supabase Dashboard → Authentication → Sign In / Providers → add Clerk (Third-party auth).
# The app uses session.getToken({ template: 'supabase' }) in src/clerk.js.

# Sentry — browser DSN (Project Settings → Client Keys). Safe to expose; omit to disable tracking.
# https://docs.sentry.io/platforms/javascript/
# VITE_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# Optional: release label for issues (e.g. git SHA or npm version)
# VITE_SENTRY_RELEASE=livingrite@1.0.0

# --- Resend (server-side only — never use the VITE_ prefix for secrets) ---
# Create an API key at https://resend.com/api-keys
# On Vercel: Project → Settings → Environment Variables (same names, no VITE_).
RESEND_API_KEY=re_xxxxxxxx
# Inbox that receives new lead notifications
RESEND_TO=coordinator@yourdomain.com
# Optional. Use a verified domain in Resend for production; onboarding@resend.dev works for testing.
# RESEND_FROM=LivingRite Care <onboarding@resend.dev>

# If you run `vite` and `vercel dev` on different ports, point the app at the API origin:
# VITE_API_BASE_URL=http://localhost:3000

# --- Cloudflare Pages (CLI-only deploy) ---
# 1) Once: npx wrangler login
# 2) Put Resend secrets for the Pages project (name matches wrangler.toml):
#    npx wrangler pages secret put RESEND_API_KEY --project-name=livingrite-learning-project
#    npx wrangler pages secret put RESEND_TO --project-name=livingrite-learning-project
#    npx wrangler pages secret put RESEND_FROM --project-name=livingrite-learning-project   # optional
# 3) Deploy from this folder (build inlines VITE_* / NEXT_PUBLIC_* from your local .env):
#    npm run cf:deploy
# Preview Functions locally: npm run cf:pages:dev
