{
  "name": "livingrite-learning-project",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:vercel": "vercel dev",
    "build": "vite build",
    "preview": "vite preview",
    "vercel": "vercel",
    "deploy": "vercel",
    "deploy:prod": "vercel --prod",
    "cf:pages:dev": "npm run build && wrangler pages dev dist --compatibility-date=2024-12-01 --env-file=.env",
