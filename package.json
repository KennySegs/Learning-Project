  },
  "dependencies": {
    "@clerk/clerk-js": "^6.3.2",
    "@sentry/browser": "^10.45.0",
    "@supabase/supabase-js": "^2.49.1",
    "resend": "^6.9.4"
  },
  "devDependencies": {
    "vercel": "^50.35.0",
    "vite": "^6.2.0",
    "wrangler": "^4.77.0"
  }
}
